# Copy to .env for local dev. Never commit real keys.

# VirusTotal public API key -- used SERVER-SIDE ONLY (Phase 3). Never ships in
# the extension bundle. Free tier = 4 lookups/min (enforced in the client).
# Without it /analyze-file still works from heuristics (VT status "unavailable").
VIRUSTOTAL_API_KEY=

# Overrides (optional)
# BSA_DB_PATH=./bsa.db
# PHISHING_MODEL_PATH=./app/models/phishing_model.pkl

# Forensic log (Phase 5): secret used to HMAC every log entry. REQUIRED -- the
# log refuses to write without it. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep it out of git and out of the DB host's backups of the DB file.
FORENSIC_HMAC_KEY=

# CORS (Phase 6). Defaults are the Vite dev server and this repo's extension
# (ID pinned by the "key" in extension/manifest.json). Comma-separated overrides:
# BSA_DASHBOARD_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# BSA_EXTENSION_IDS=gknjaknibkcfffkjjceppndfodajfjil
